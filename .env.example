# Google Gemini TTS (podcast audio). Optional locally if a proxy injects the key.
GEMINI_API_KEY=
# Optional overrides
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_VOICE_HOST=Charon
GEMINI_VOICE_GUEST=Puck

# Oracle Object Storage, S3 Compatibility API (podcast publish / url)
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_REGION=us-ashburn-1
S3_BUCKET=
# Oracle "customer secret key" pair
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
